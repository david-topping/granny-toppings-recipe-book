          "quantity": "6",
          "unit": "lb",
          "item": "sugar",
          "preparation": "",
          "note": ""
        }
      ],
      "method": [
        "Soak overnight with the pips in a muslin bag.",
        "Next day, boil for 1 hour. Leave overnight.",
        "Remove the pips and boil with the sugar for 1 hour.",
